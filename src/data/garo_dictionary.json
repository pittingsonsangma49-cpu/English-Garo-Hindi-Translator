      { "english": "Why", "garo": "Maina / Maini-gimin" },
      { "english": "How", "garo": "Maidake / Maikai" },
      { "english": "How many", "garo": "Baitarong" },
      { "english": "How much", "garo": "Baita" },
      { "english": "Which", "garo": "Badia / Badiya" },
      { "english": "Which way", "garo": "Bagita" }
    ],
    "commands_and_requests": [
      { "english": "Give me water", "garo": "Angna chi on·bo" },
      { "english": "Please sit down", "garo": "Asongbo ka·sapae" },
      { "english": "Come quick!", "garo": "Tarake re·babo!" },
