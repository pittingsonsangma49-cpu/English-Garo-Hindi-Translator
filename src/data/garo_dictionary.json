      { "english": "Let's eat", "garo": "Hai cha·ha" },
      { "english": "Let's go", "garo": "Hai re·naha" }
    ],
    "negation": [
      { "english": "I don't know", "garo": "Anga uija" },
      { "english": "I don't want", "garo": "Anga nang·ja" },
      { "english": "Don't eat", "garo": "Cha·bo ong·ja" },
      { "english": "I don't care", "garo": "Anga Dal·e Ra·ja" },
      { "english": "Not tasty", "garo": "Touja" },
      { "english": "No more", "garo": "Dongja" },
      { "english": "It exists", "garo": "Donga" }
    ],
    "key_corrections": [
      "Tasty = Toa (NOT Cha·toa)",
      "Not tasty = Touja",
      "Wait = Damo / Sengbo",
      "Salt = Kari",
      "Dongja = No more / doesn't exist",
      "Donga = It exists / It is there",
      "Quick = Tarkbo",
      "I don't care = Anga Dal·e Ra·ja",
      "Hai = expression particle for collective action (let's), NOT translated from 'let'",
      "sala = drive AND pull (same word — context determines meaning)",
      "jroa = swim AND stinging sensation (same word)",
      "rua = pour (verb) AND axe (noun)",
      "goa = shoot; goata = throw (different words)"
    ]
  },
  "classifier_engine": {
    "_source": "garo_classifier.js",
    "word_order": "NOUN + CLASSIFIER-NUMBER (e.g. achak mang-sa = one dog)",
    "classifiers": {
      "mang": { "used_for": "animals, birds, fish, insects", "categories": ["animals", "birds", "insects_and_aquatic", "animal_actions_and_parts"] },
      "sak": { "used_for": "people and persons", "categories": ["family_members", "occupations", "social_people"] },
      "gong": { "used_for": "money and currency", "categories": ["at_the_market"] },
      "king": { "used_for": "books, paper, leaves, flat/thin objects", "categories": ["education"] },
      "ge": { "used_for": "objects, tools, things — general fallback", "categories": ["fruits", "vegetables_and_roots", "household_items", "clothing_and_wearables", "kitchen_and_cooking", "travel_and_transport", "materials_and_textures"] }
    },
    "numbers": {
      "1": "sa",
      "2": "gni",
      "3": "gittam",
      "4": "bri",
      "5": "bonga",
      "6": "dok",
      "7": "sni",
      "8": "chet",
      "9": "sku",
      "10": "chiking"
    },
    "examples": [
      { "english": "one dog", "garo": "achak mang-sa" },
      { "english": "two dogs", "garo": "achak mang-gni" },
      { "english": "three books", "garo": "ki·tap king-gittam" },
      { "english": "one person", "garo": "mande sak-sa" },
      { "english": "five coins", "garo": "tangka gong-bonga" },
      { "english": "ten birds", "garo": "do·a mang-chiking" }
    ],
    "validation_rule": "Classifier must come BEFORE number. Correct: mang-sa. Wrong: sa-mang."
  }
}
