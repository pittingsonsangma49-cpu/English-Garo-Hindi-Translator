  "grammar_rules": {
    "word_order": {
      "rule": "SOV — Subject Object Verb. NEVER translate English SVO word order directly into Garo.",
      "examples": [
        { "english": "I eat rice", "garo": "Anga mi cha·a", "note": "Subject + Object + Verb" },
        { "english": "She drinks water", "garo": "Ua chi ringa", "note": "Subject + Object + Verb" },
        { "english": "Did you go to the market?", "garo": "Na·a bajalchi re·angama?", "note": "Subject + Place+chi + Verb+ama?" },
        { "english": "Give me water", "garo": "Angna chi on·bo", "note": "Recipient+na + Object + Verb+bo" }
      ]
    },
    "tense_suffixes": [
      { "tense": "Past simple", "suffix": "verb + ·a", "example": "re·ang·a (went), cha·a (ate), tusi·a (slept)" },
      { "tense": "Past simple (alt)", "suffix": "verb + aha", "example": "cha·aha (ate), reba·aha (came)" },
      { "tense": "Past perfect", "suffix": "verb + man·aha", "example": "chaman·aha (had eaten)" },
      { "tense": "Present perfect", "suffix": "verb + manjok", "example": "chamanjok (has eaten)" },
      { "tense": "Present continuous", "suffix": "verb + enga", "example": "cha·enga (is eating), re·angenga (is going)" },
      { "tense": "Future", "suffix": "verb + en / gen", "example": "chagen (will eat), reangen (will come)" },
      { "tense": "Imperative / Command", "suffix": "verb + bo", "example": "chabo (eat!), reangbo (go!), asongbo (sit!)" },
      { "tense": "Let's [verb]", "suffix": "Hai + verb + ha", "example": "Hai cha·ha (let's eat), Hai re·naha (let's go)" },
      { "tense": "Ability / Permission (question)", "suffix": "verb + mangenma?", "example": "on·a mangenma? (can you give?)" },
      { "tense": "Ability / Permission (answer)", "suffix": "mangenva", "example": "Hoe mangenva (yes, of course)" },
      { "tense": "Past question", "suffix": "verb + ama?", "example": "cha·ama? (did you eat?)" },
      { "tense": "Present question", "suffix": "verb + engma?", "example": "cha·engma? (are you eating?)" },
      { "tense": "Negation", "suffix": "verb + ong·ja / -ja", "example": "uija (don't know), Touja (not tasty)" },
      { "tense": "Location suffix", "suffix": "noun + chi", "example": "bajalchi (at/to market), nokchi (at home)" },
      { "tense": "Recipient suffix", "suffix": "person + na", "example": "Angna (to me), Nangna (to you)" },
      { "tense": "Plural marker", "suffix": "-chim", "example": "sing·ani chim (the questions)" },
      { "tense": "With (postposition)", "suffix": "ming", "example": "ang·ming (with me), nangming (with you)" }
    ],
    "question_words": [
      { "english": "What", "garo": "Maia / Maiko (object form)" },
      { "english": "Who", "garo": "Sawa" },
      { "english": "Whom", "garo": "Sako" },
